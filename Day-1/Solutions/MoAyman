public static int FindMaxConsecutiveOnes(int[] nums)
{
    int MaxCounter = 0;
    int counter = 0;
    for (int i = 0; i < nums.Length; i++)
    {
        if (nums[i] == 1)
        {
            counter++;
        }
        else
        {
            if (MaxCounter < counter) MaxCounter = counter;
            counter = 0;
        }
    }

    if (MaxCounter < counter) MaxCounter = counter;
    return MaxCounter;
}
